@page "/login"
@inject NavigationManager Navigation
@using DotaInviteHelper.Services
@using DotaInviteHelper.Components
@using SteamKit2;
@inject DotaClient dota
@inject NavigationManager Navigation

<MudPaper Class="pa-8 mt-6 justify-center" Outlined="true">
	<MudStack Spacing="5">
		<MudText Typo="Typo.h5">
			Login to Steam Account
		</MudText>
		<MudTextField Immediate="true" AutoFocus="true" @bind-Value="LoginValue" Label="Login" Variant="Variant.Text" />
		<MudTextField InputType="InputType.Password" Immediate="true" @bind-Value="PasswordValue" Label="Password" Variant="Variant.Text" />
		<MudButton Disabled="@(string.IsNullOrWhiteSpace(LoginValue) || string.IsNullOrWhiteSpace(PasswordValue))" Variant="Variant.Outlined" OnClick="LoginSteam">
			@if (IsLoading)
			{
				<MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true"/>
			}
			else
			{
				<span>Login</span>
			}
		</MudButton>
	</MudStack>
</MudPaper>

@code{
	[Inject] private IDialogService DialogService { get; set; }

	public string LoginValue { get; set; }
	public string PasswordValue { get; set; }
	public bool IsLoading { get; set; }

	protected override void OnAfterRender(bool firstRender)
	{
		base.OnAfterRender(firstRender);
		App.Current.Windows.FirstOrDefault().Destroying += (s, e) => dota.Exit();

		if (firstRender)
		{
			dota.LoggedIn += Dota_LoggedIn;
			dota.AuthFailed += Dota_AuthFailed;
			dota.DeviceCodeRequested += Dota_DeviceCodeRequested;
			dota.EmailCodeRequested += Dota_EmailCodeRequested;
		}
	}

	void LoginSteam()
	{
		dota.Connect(LoginValue, PasswordValue);
		IsLoading = true;
	}

	// Steam Guard code from the mobile authenticator app.
	async Task<string> Dota_DeviceCodeRequested(bool previousCodeWasIncorrect)
	{
		var parameters = new DialogParameters();
		parameters.Add("Placeholder", previousCodeWasIncorrect ? "Wrong code, try again" : "Your Steam Guard code");
		var result = await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.Show<PromptDialog>("Steam Guard", parameters).Result);
		return (string)result.Data;
	}

	// Code Steam emailed to the account.
	async Task<string> Dota_EmailCodeRequested(string email, bool previousCodeWasIncorrect)
	{
		var parameters = new DialogParameters();
		parameters.Add("Placeholder", previousCodeWasIncorrect ? "Wrong code, try again" : $"Code sent to {email}");
		var result = await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.Show<PromptDialog>("Email verify", parameters).Result);
		return (string)result.Data;
	}

	// The auth session itself failed (bad login/password, rate limit, etc),
	// before we ever get as far as SteamUser.LoggedOnCallback.
	private async void Dota_AuthFailed(EResult result, string message)
	{
		switch (result)
		{
			case EResult.InvalidPassword:
			case EResult.InvalidName:
			case EResult.InvalidEmail:
				await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.ShowMessageBox("Error", "Check login or password"));
				break;

			case EResult.RateLimitExceeded:
				await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.ShowMessageBox("Error", "Rate limit reached\nPlease try later"));
				break;

			default:
				await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.ShowMessageBox("Error", "Unresolved error:\n" + message));
				break;
		}
		IsLoading = false;
		await MainThread.InvokeOnMainThreadAsync(() => StateHasChanged());
	}

	private async void Dota_LoggedIn(SteamUser.LoggedOnCallback callback)
	{
		if (callback.Result != EResult.OK)
		{
			await MainThread.InvokeOnMainThreadAsync(async () => await DialogService.ShowMessageBox("Error", "Unresolved error:\n" + callback.ExtendedResult));
			IsLoading = false;
			await MainThread.InvokeOnMainThreadAsync(() => StateHasChanged());
			return;
		}
		IsLoading = false;
		Navigation.NavigateTo("main");
	}
}
